# Copia este archivo como .env (no se sube al repositorio) y cambia las contraseñas.
POSTGRES_DB=bankdoit
POSTGRES_USER=bankdoit
POSTGRES_PASSWORD=cambia_esta_contrasena
REPLICADOR_PASSWORD=cambia_esta_otra

# --- Simulación en una sola PC: deja lo de abajo comentado. ---------
# --- Despliegue real en dos equipos (ver README.md): ----------------
# IP de cada equipo dentro de la VPN (por ejemplo Tailscale o ZeroTier).
# En la PC de escritorio de Luis (Nodo A, perfil nodo-a):
#   BIND_IP=<IP de la PC de escritorio de Luis>
#   PAR_PRIMARIO_HOST=<IP de la laptop de Luis>
#   PAR_PRIMARIO_PUERTO=5451
# En la laptop de Luis (Nodo B, perfil nodo-b):
#   BIND_IP=<IP de la laptop de Luis>
#   IMPAR_PRIMARIO_HOST=<IP de la PC de escritorio de Luis>
#   IMPAR_PRIMARIO_PUERTO=5441

# --- Acceso de la API (#32) -------------------------------------------
# Contraseña de la cuenta bankdoit_api (la usa Luis en BANKDOIT_PG_PASSWORD).
BANKDOIT_API_PASSWORD=cambia_la_de_la_api
# Subred de Docker y orígenes permitidos en pg_hba.conf (listas separadas
# por espacios). En la simulación todo llega por la subred de Docker.
RED_DOCKER_SUBNET=172.28.0.0/16
RED_CIDR=172.28.0.0/16
API_ORIGEN_CIDR=172.28.0.0/16
# Despliegue real: agrega la subred de la VPN, por ejemplo
#   RED_CIDR=172.28.0.0/16 100.64.0.0/10
#   API_ORIGEN_CIDR=172.28.0.0/16 100.64.0.0/10

# --- Monitoreo (#59) ---------------------------------------------------
# Rol de solo lectura del exportador de Prometheus y acceso a Grafana.
BANKDOIT_MONITOR_PASSWORD=cambia_la_del_monitor
GRAFANA_ADMIN_PASSWORD=cambia_la_de_grafana
# PUERTO_PROMETHEUS=9090
# PUERTO_GRAFANA=3000
