# Copia este archivo como .env (no se sube al repositorio) y cambia las contraseñas.
POSTGRES_DB=bankdoit
POSTGRES_USER=bankdoit
POSTGRES_PASSWORD=cambia_esta_contrasena
REPLICADOR_PASSWORD=cambia_esta_otra

# --- Simulación en una sola PC: deja lo de abajo comentado. ---------
# --- Despliegue real en dos equipos (ver README.md): ----------------
# IP de cada equipo dentro de la VPN (por ejemplo Tailscale o ZeroTier).
# En la PC de Luis (perfil nodo-a):
#   BIND_IP=<IP VPN de la PC de Luis>
#   PAR_PRIMARIO_HOST=<IP VPN del nodo remoto>
#   PAR_PRIMARIO_PUERTO=5451
# En el nodo remoto (perfil nodo-b):
#   BIND_IP=<IP VPN del nodo remoto>
#   IMPAR_PRIMARIO_HOST=<IP VPN de la PC de Luis>
#   IMPAR_PRIMARIO_PUERTO=5441
